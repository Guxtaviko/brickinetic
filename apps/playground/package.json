{
	"name": "@brickinetic/playground",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx scripts/generate-api.ts && react-router dev",
		"typecheck": "tsc -b --pretty false",
		"build": "tsx scripts/generate-api.ts && react-router build",
		"test:browser": "playwright test",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"preview": "vite preview --outDir dist/client",
		"verify:offline": "tsx scripts/verify-offline-fixture.ts",
		"test": "node --import tsx --test spec/unit/*.spec.ts"
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.2.8",
		"@react-three/fiber": "catalog:",
		"brickinetic": "workspace:*",
		"fumadocs-core": "16.18.1",
		"fumadocs-mdx": "15.5.0",
		"fumadocs-typescript": "5.6.0",
		"fumadocs-ui": "16.18.1",
		"isbot": "^5",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router": "8.5.1",
		"three": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@react-router/dev": "8.5.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/mdx": "2.0.13",
		"@types/node": "^22.20.5",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/three": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"engines": {
		"node": ">=22.22.0"
	}
}
