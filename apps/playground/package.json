{
	"name": "@brickinetic/playground",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"typecheck": "tsc -b --pretty false && node .compiled/scripts/prepare-browser-scripts.js",
		"build": "tsc -b && node .compiled/scripts/prepare-browser-scripts.js && vite build",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"preview": "vite preview",
		"build:scripts": "tsc -p tsconfig.scripts.json && tsc -p tsconfig.browser-scripts.json && node .compiled/scripts/prepare-browser-scripts.js",
		"verify:offline": "node .compiled/scripts/verify-offline-fixture.js",
		"verify:foundation": "node .compiled/scripts/verify-foundation.js",
		"measure:foundation": "node .compiled/scripts/measure-foundation.js",
		"cycle:foundation": "node .compiled/scripts/cycle-foundation.js",
		"summarize:foundation": "node .compiled/scripts/summarize-foundation.js"
	},
	"dependencies": {
		"@react-three/fiber": "catalog:",
		"brickinetic": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:",
		"three": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.5",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/three": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"playwright": "^1.64.1",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
