{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"noEmitOnError": true,
		"types": ["node"],
		"noEmit": true,
		"lib": ["ES2023", "DOM"],
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo"
	},
	"include": ["scripts/**/*.ts", "spec/**/*.ts", "playwright.config.ts"]
}
