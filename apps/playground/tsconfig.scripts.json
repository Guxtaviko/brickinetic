{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"noEmitOnError": true,
		"types": ["node", "vite/client"],
		"noEmit": true,
		"lib": ["ES2023", "DOM"],
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
		"jsx": "react-jsx",
		"paths": {
			"brickinetic": ["../../packages/brickinetic/src/index.ts"]
		}
	},
	"include": [
		"scripts/**/*.ts",
		"spec/**/*.ts",
		"playwright.config.ts",
		"spec/**/*.tsx"
	]
}
