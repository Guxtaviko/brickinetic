{
	"compilerOptions": {
		"target": "ES2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"ignoreDeprecations": "6.0",
		"moduleDetection": "legacy",
		"outDir": ".compiled/scripts",
		"strict": true,
		"skipLibCheck": true,
		"noEmitOnError": true,
		"rootDir": "scripts",
		"removeComments": true
	},
	"include": [
		"scripts/verify-browser.ts",
		"scripts/verify-model-loading.ts",
		"scripts/browser-globals.d.ts"
	]
}
