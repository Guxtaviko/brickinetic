{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".compiled/**"]
		},
		"typecheck": {
			"dependsOn": ["build"],
			"cache": false
		},
		"test": {
			"dependsOn": ["build"]
		},
		"smoke:node": {
			"dependsOn": ["build"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true
		}
	}
}
